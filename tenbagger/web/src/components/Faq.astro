---
import site from '../../site.config.ts';
interface Props { items?: ReadonlyArray<{ q: string; a: string }> }
const { items = site.faq } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>

<style is:global>
  .faq { border-top: 1px solid var(--rule); max-width: 820px; }
  .faq details { border-bottom: 1px solid var(--rule); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 18px 0; font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--font-mono); color: var(--accent); font-size: 1.3rem; line-height: 1; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin: 0 0 18px; color: var(--muted); max-width: 44em; }
</style>
