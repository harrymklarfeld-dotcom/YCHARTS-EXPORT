---
/**
 * Playable lesson (island). Renders a static intro card server-side; the custom
 * element takes over in the browser.
 */
import type { Lesson, Question } from '../lib/data.ts';
import { marked } from 'marked';
interface Props {
  lesson: Lesson | null;
  questions: Question[];
  ctaHref?: string;
  ctaLabel?: string;
  totalLessons?: number;
  showIntro?: boolean;
  /** Hide XP on the result screen (articles: XP only comes from lessons in the app). */
  noXp?: boolean;
}
const { lesson, questions, ctaHref, ctaLabel, totalLessons, showIntro = true, noXp = false } = Astro.props;
const introHtml = lesson ? (marked.parse(lesson.intro, { async: false }) as string) : '';
---
{questions.length === 0 ? (
  <div class="widget widget-error">The demo lesson will appear here once <code>data/lessons.json</code> is built.</div>
) : (
  <lesson-player class="lp" data-cta-href={ctaHref} data-cta-label={ctaLabel} data-total-lessons={totalLessons} data-no-xp={noXp ? '' : undefined}>
    <script type="application/json" set:html={JSON.stringify(questions).replace(/</g, '\\u003c')}></script>
    <div class="lp-top">
      <div class="lp-track" aria-hidden="true"><div class="lp-bar" data-bar></div></div>
      <span class="lp-count mono small" data-count>{`0 / ${questions.length}`}</span>
    </div>
    <div class="lp-stage" data-stage>
      {showIntro && lesson && (
        <div class="lp-intro">
          <p class="widget-kicker">Lesson · {lesson.title}</p>
          <div class="lp-intro-text" set:html={introHtml} />
          <button type="button" class="btn btn-primary" data-start>Start the {questions.length}-question lesson</button>
          <noscript><p class="small muted">Turn on JavaScript to play the lesson.</p></noscript>
        </div>
      )}
    </div>
  </lesson-player>
)}

<script>
  import '../scripts/lesson-player.ts';
</script>

<style is:global>
  .lp { display: block; background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 20px; box-shadow: 0 1px 0 var(--rule), 0 18px 40px -24px rgb(0 0 0 / 0.25); }
  .lp-top { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .lp-track { flex: 1; height: 8px; border-radius: 99px; background: var(--surface2); overflow: hidden; }
  .lp-bar { height: 100%; width: 0; background: var(--accent); border-radius: 99px; transition: width 0.3s ease; }
  .lp-count { color: var(--muted); }
  .lp-intro-text { font-size: 0.98rem; color: var(--ink); }
  .lp-intro-text p { margin-bottom: 0.8em; }
  .lp-src { display: inline-block; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--rule); border-radius: 3px; padding: 2px 6px; margin-bottom: 10px; }
  .lp-prompt { font-family: var(--font-display); font-size: 1.32rem; line-height: 1.3; font-weight: 600; margin-bottom: 16px; }
  .lp-choices { display: grid; gap: 10px; }
  .lp-compare { grid-template-columns: 1fr 1fr; }
  .lp-choice { display: flex; align-items: center; gap: 12px; text-align: left; font: inherit; font-size: 1rem; color: var(--ink); background: var(--bg); border: 1.5px solid var(--rule); border-bottom-width: 3px; border-radius: 8px; padding: 12px 14px; cursor: pointer; min-height: 52px; }
  .lp-choice:hover { border-color: var(--muted); }
  .lp-key { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border: 1.5px solid var(--rule); border-radius: 5px; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--muted); }
  .lp-choice.is-picked { border-color: var(--accent); background: var(--accent-soft); }
  .lp-choice.is-picked .lp-key { border-color: var(--accent); color: var(--accent); }
  .lp-choice.is-right { border-color: var(--positive); background: color-mix(in srgb, var(--positive) 14%, var(--surface)); }
  .lp-choice.is-wrong { border-color: var(--negative); background: color-mix(in srgb, var(--negative) 12%, var(--surface)); }
  .lp-num { display: flex; align-items: center; gap: 8px; }
  .lp-num input { flex: 1; font-family: var(--font-mono); font-size: 1.2rem; }
  .lp-num input.is-right { border-color: var(--positive); }
  .lp-num input.is-wrong { border-color: var(--negative); }
  .lp-unit { font-family: var(--font-mono); color: var(--muted); font-size: 1.1rem; min-width: 1ch; }
  .lp-foot { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; justify-content: space-between; margin: 18px -20px -20px; padding: 16px 20px; border-top: 1px solid var(--rule); border-radius: 0 0 10px 10px; }
  .lp-foot.is-ok { background: color-mix(in srgb, var(--positive) 12%, var(--surface)); }
  .lp-foot.is-no { background: color-mix(in srgb, var(--negative) 10%, var(--surface)); }
  .lp-feedback { flex: 1 1 260px; }
  .lp-feedback:empty { display: none; }
  .lp-verdict { font-weight: 700; margin: 0 0 4px; }
  .is-ok .lp-verdict { color: var(--positive); }
  .is-no .lp-verdict { color: var(--negative); }
  .lp-expl { font-size: 0.92rem; margin: 0; color: var(--ink); }
  .lp-check { margin-left: auto; min-width: 140px; }
  .lp-done { text-align: center; padding: 20px 0 4px; }
  .lp-done .btn-row { justify-content: center; }
  .lp-done-title { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; margin: 8px 0; }
  @media (max-width: 480px) { .lp-compare { grid-template-columns: 1fr; } .lp-prompt { font-size: 1.15rem; } }
</style>
