{
  "schema_version": 1,
  "units": [
    {
      "id": "u1-margins",
      "title": "Margins",
      "summary": "How much of each sales dollar a business keeps.",
      "order": 1,
      "lessons": [
        {
          "id": "u1-l1",
          "title": "Gross margin",
          "xp": 10,
          "intro": "# Gross margin\n\nEvery dollar a company sells has a cost attached. **Gross margin** tells you how much of each sales dollar is left after paying for the goods themselves.\n\n- Gross profit = revenue − cost of revenue\n- Gross margin = gross profit / revenue\n\nA warehouse club and a software company can both be great businesses with very different gross margins.",
          "questions": [
            {
              "id": "q-u1l1-1",
              "type": "multiple_choice",
              "prompt": "Costco had $275.2B of revenue and $239.9B cost of revenue in FY2025. What is its gross margin?",
              "choices": [
                "87.2%",
                "12.8%",
                "2.9%",
                "25.7%"
              ],
              "answer": 1,
              "unit": "percent",
              "explanation": "Gross margin = gross profit / revenue = $35.3B / $275.2B = 12.8%.",
              "source": {
                "ticker": "COST",
                "fy": 2025,
                "metrics": [
                  "gross_margin"
                ],
                "formula": "gross_profit / revenue"
              }
            },
            {
              "id": "q-u1l1-2",
              "type": "numeric",
              "prompt": "Microsoft: revenue $281.7B, gross profit $193.9B. Enter its gross margin in %.",
              "answer": 0.688321,
              "tolerance": 0.005,
              "unit": "percent",
              "explanation": "$193.9B / $281.7B = 68.8%. Software costs little to copy, so most of each sale is gross profit.",
              "source": {
                "ticker": "MSFT",
                "fy": 2025,
                "metrics": [
                  "gross_margin"
                ],
                "formula": "gross_profit / revenue"
              }
            },
            {
              "id": "q-u1l1-3",
              "type": "true_false",
              "prompt": "True or false: Costco's gross margin (12.8%) is higher than Apple's.",
              "answer": false,
              "unit": "none",
              "explanation": "Apple's gross margin is 46.9% vs Costco's 12.8%. Costco deliberately prices goods close to cost and earns money from membership fees.",
              "source": {
                "ticker": "AAPL",
                "fy": 2025,
                "metrics": [
                  "gross_margin"
                ],
                "formula": "gross_profit / revenue"
              }
            },
            {
              "id": "q-u1l1-4",
              "type": "compare",
              "prompt": "Which company keeps more of each sales dollar after the cost of goods?",
              "choices": [
                "KO",
