              ],
              "answer": 0,
              "unit": "percent",
              "explanation": "Coca-Cola's gross margin is 61.0% vs Target's 28.2%. Selling a branded syrup costs far less than stocking shelves.",
              "source": {
                "ticker": "KO",
                "fy": 2025,
                "metrics": [
                  "gross_margin"
                ],
                "formula": "gross_profit / revenue"
              }
            },
            {
              "id": "q-u1l1-5",
              "type": "order",
              "prompt": "Rank these by gross margin, highest first.",
              "choices": [
                "COST",
